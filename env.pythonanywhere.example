# Copy to .env on PythonAnywhere (do NOT commit .env).
# Replace YOUR_USERNAME with your PythonAnywhere username.

FLASK_ENV=production
FLASK_DEBUG=False

# Generate with: python generate_secret_key.py
SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secret_key.py

# Absolute SQLite path (4 slashes after sqlite:). Change YOUR_USERNAME.
DATABASE_URL=sqlite:////home/YOUR_USERNAME/ComicbookMgr/instance/comicbook.db

# Optional APIs (ComicVine / eBay need outbound HTTPS — use a paid PA plan)
COMICVINE_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_CA

# Keep caches smaller on shared hosting (256 MB each)
CACHE_DIR=/home/YOUR_USERNAME/ComicbookMgr/instance/cache
CACHE_SIZE_LIMIT=268435456
READER_CACHE_DIR=/home/YOUR_USERNAME/ComicbookMgr/instance/reader_cache
READER_CACHE_SIZE_LIMIT=268435456
DIGITAL_FOLDER=/home/YOUR_USERNAME/ComicbookMgr/instance/digital
COVERS_FOLDER=/home/YOUR_USERNAME/ComicbookMgr/instance/covers

# Password-reset email (optional; Gmail app password recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
