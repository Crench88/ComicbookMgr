# Copy to .env on PythonAnywhere (do NOT commit .env).
# Relative paths below work as long as you start the app from ~/ComicbookMgr
# (the WSGI file does os.chdir to the project). No account-name path edits needed.

FLASK_ENV=production
FLASK_DEBUG=False

# Generate with: python generate_secret_key.py
SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secret_key.py

# Relative sqlite file → resolved into instance/comicbook.db by the app
DATABASE_URL=sqlite:///comicbook.db

# Idle logoff for every authenticated user, including admins (seconds).
IDLE_TIMEOUT_SECONDS=1800

# Optional APIs (ComicVine / eBay need outbound HTTPS — use a paid PA plan)
COMICVINE_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_CA

# Keep caches smaller on shared hosting (256 MB each)
CACHE_DIR=instance/cache
CACHE_SIZE_LIMIT=268435456
READER_CACHE_DIR=instance/reader_cache
READER_CACHE_SIZE_LIMIT=268435456
DIGITAL_FOLDER=instance/digital
COVERS_FOLDER=instance/covers

# Password-reset email (optional; Gmail app password recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
