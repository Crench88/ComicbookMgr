# Comic Book Collection Manager - Environment Variables
# Copy this file to .env and update the values

# Flask Configuration
# Generate a secure secret key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Production settings (set these for production deployment)
# FLASK_ENV=production
# FLASK_DEBUG=False

# Database Configuration
DATABASE_URL=sqlite:///comicbook.db

# File Upload Configuration
# Includes Base64 cover variants submitted from the edit form (64 MB).
MAX_CONTENT_LENGTH=67108864
UPLOAD_FOLDER=instance/uploads

# Security Configuration
WTF_CSRF_ENABLED=True
WTF_CSRF_SECRET_KEY=your-csrf-secret-key

# Comic Book API Configuration
# Get your API key from: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=your-comicvine-api-key-here

# Optional barcode lookup (used when searching by UPC)
UPC_DATABASE_API_KEY=
BARCODE_LOOKUP_API_KEY=

# Shared API response cache (diskcache; shared across gunicorn workers on same host)
CACHE_DIR=instance/cache
# Maximum disk cache size in bytes (default 512 MB)
CACHE_SIZE_LIMIT=536870912

# Price lookups from eBay listings.
# Create an app at https://developer.ebay.com/my/keys and paste the production
# App ID (Client ID) and Cert ID (Client Secret). No user login is needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_CA is eBay Canada (prices in CAD). EBAY_US, EBAY_GB, EBAY_AU also work.
EBAY_MARKETPLACE_ID=EBAY_CA
# Set to sandbox to test against eBay's sandbox host
EBAY_ENVIRONMENT=production
# Optional: restrict searches to one eBay category id (leave blank for all)
EBAY_COMIC_CATEGORY_ID=
# Asking prices run above real sale prices; 0.8 keeps estimates at 80% of the ask
PRICE_ASK_TO_SOLD_RATIO=0.8

# Digital comic archives (CBZ/CBR) and the extracted page cache
DIGITAL_FOLDER=instance/digital
READER_CACHE_DIR=instance/reader_cache
# LRU page cache cap in bytes (default 512 MB)
READER_CACHE_SIZE_LIMIT=536870912

# Email Configuration (for password reset functionality)
# Gmail example (recommended for development):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Alternative email providers:
# For Outlook/Hotmail:
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# For Yahoo:
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# Optional: PostgreSQL Configuration (for production)
# DATABASE_URL=postgresql://username:password@localhost/comicbook_db
